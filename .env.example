# RecoverAI environment. Copy to .env and fill in. NEVER commit a real .env.

# --- Runtime ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true
# Keep message content out of logs (PII minimization). Leave true in production.
LOG_REDACT_CONTENT=true

# --- Database ---
# postgres (default) uses DATABASE_URL. memory runs a zero-dependency in-process store
# (demo, tests, evaluation). Data is lost on restart in memory mode.
DB_DRIVER=memory
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recoverai
DATABASE_SSL=auto
DATABASE_POOL_MAX=10
MIGRATIONS_DIR=migrations

# --- Razorpay ---
# mock (default) is a deterministic in-process double. razorpay_test is the real
# Razorpay Test Mode integration (no live money).
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret used to verify X-Razorpay-Signature. Required in production.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_MS=15000
RAZORPAY_LINK_EXPIRY_MINUTES=1440

# --- LLM (bounded reasoning only, never authority over money) ---
# mock (default, deterministic) or gemini.
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=12000
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=700
LLM_THINKING_BUDGET=0

# --- Economics (used by the deterministic expected-value engine) ---
# Cost booked per contact, in paise. Sending a link is not free.
INTERVENTION_COST_PAISE=300
# Multiplier on amount for suspicious cases, to discourage autonomous action.
RISK_COST_FACTOR=0.5
# Baseline probability a customer self-recovers with no intervention.
BASELINE_SELF_RECOVERY=0.08
