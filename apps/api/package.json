{
  "name": "@recoverai/api",
  "version": "0.1.0",
  "private": true,
  "description": "RecoverAI API: webhook ingestion, recovery decision engine, policy gates, Razorpay integration, evaluation.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "npm run migrate:deploy && node dist/server.js",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:deploy": "node dist/db/migrate.js up",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed-demo.ts",
    "gen:dataset": "tsx src/evaluation/generate-dataset.ts",
    "train": "tsx src/evaluation/train-model.ts",
    "eval": "tsx src/evaluation/run.ts",
    "demo": "tsx src/scripts/run-scenarios.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
